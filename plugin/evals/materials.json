    {
      "id": "paper-evidence-review",
      "kind": "document",
      "paths": ["docs/reviews/evidence-review.md"],
      "learning_goal": "能说明检索练习、自我解释与概念图三类证据如何共同支撑'从记忆中重建'这一设计，并指出评审识别出的最大风险",
      "expect": {"sections": [5, 9], "max_concepts_per_section": 4, "min_relations": 4}
